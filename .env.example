# Copy to .env on the workstation. Never commit .env.
# Same-machine Ollama:
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Second machine on a private LAN (replace the host; do not commit the real value):
# OLLAMA_BASE_URL=http://<inference-host>:11434
# WSL GPU host via SSH local forward (see examples/downstairs-wsl-gpu.md):
# ssh -N -p <ssh-port> -L 11434:127.0.0.1:11434 user@<wsl-host>
# OLLAMA_BASE_URL=http://127.0.0.1:11434

OLLAMA_FAST_MODEL=qwen3.5:9b
OLLAMA_STRONG_MODEL=devstral-small-2
OLLAMA_NUM_CTX=16384
